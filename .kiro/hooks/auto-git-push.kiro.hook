{
  "enabled": true,
  "name": "Auto Git Commit & Push",
  "description": "Automatically stages all changes, commits with a descriptive message, and pushes to GitHub when the agent finishes its work.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git commit -m \"auto: update from Kiro agent\" && git push"
  }
}