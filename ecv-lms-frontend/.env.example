# =============================================================================
# ECV LMS Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
#
# After deploying the CDK stack (moodle-cdk), copy values from the
# CloudFormation outputs: CognitoUserPoolId, CognitoUserPoolClientId,
# CognitoUserPoolDomainName.
# =============================================================================

# ---------------------------------------------------------------------------
# Demo Mode
# ---------------------------------------------------------------------------
# Set to "true" to run with mock data (no Cognito or Moodle required).
# Set to "false" or remove to use real Cognito authentication + Moodle API.
NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# AWS Cognito — Client-side (NEXT_PUBLIC_ prefix = exposed to browser)
# ---------------------------------------------------------------------------
# These are used by the Amplify SDK for sign-in, sign-up, and token refresh.
# Get these values from the CDK stack CloudFormation outputs.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_DOMAIN=ecv-lms-production.auth.ap-southeast-1.amazoncognito.com

# ---------------------------------------------------------------------------
# AWS Cognito — Server-side (BFF JWT verification)
# ---------------------------------------------------------------------------
# Used by the Next.js API routes (BFF) to verify Cognito JWT tokens.
# These should match the NEXT_PUBLIC_ values above.
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Moodle — Server-side only (never exposed to browser)
# ---------------------------------------------------------------------------
# MOODLE_URL: Base URL of your Moodle instance (no trailing slash).
# MOODLE_WS_TOKEN: Web Services token with appropriate permissions.
#   Generate via: Moodle Admin > Site administration > Plugins > Web services
#   > Manage tokens. The token needs access to all core_* WS functions used
#   by the BFF routes.
MOODLE_URL=https://lms.ecvth.com
MOODLE_WS_TOKEN=your-moodle-web-services-token

# ---------------------------------------------------------------------------
# AWS S3 Media Storage — Client-side (Amplify Storage)
# ---------------------------------------------------------------------------
# Identity Pool is required for Amplify Storage (S3 direct uploads).
# Media bucket stores course videos, thumbnails, and materials.
# CDN domain serves media files via CloudFront.
# Get these from CDK stack outputs: IdentityPoolId, MediaBucketName, MediaCdnDomain.
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=ap-southeast-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_MEDIA_BUCKET=ecv-lms-production-media-123456789012
NEXT_PUBLIC_MEDIA_CDN_DOMAIN=dxxxxxxxxxx.cloudfront.net
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
