{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "moodle:environment": "production",
    "moodle:region": "ap-southeast-1",
    "moodle:domainName": "lms.ecvth.com",
    "moodle:albCertificateArn": "arn:aws:acm:ap-southeast-1:159184128979:certificate/9146e8e7-b208-45c4-a85a-781604ef6ec8",
    "moodle:cloudfrontCertificateArn": "arn:aws:acm:us-east-1:159184128979:certificate/106a9c18-46c0-4b83-8a6a-50a6cff3e4f4",
    "moodle:taskCpu": 2048,
    "moodle:taskMemory": 4096,
    "moodle:minTasks": 1,
    "moodle:maxTasks": 10,
    "moodle:cpuTargetUtilization": 50,
    "moodle:spotPercentage": 75,
    "moodle:minAcu": 0.5,
    "moodle:maxAcu": 10,
    "moodle:backupRetentionDays": 7,
    "moodle:maxEcpu": 1000,
    "moodle:maxCacheDataGb": 10,
    "moodle:opcacheMemory": 512,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk-containers/ecs-service-extensions:enableDefaultLogDriver": true,
    "@aws-cdk/core:stackRelativeExports": true
  }
}
